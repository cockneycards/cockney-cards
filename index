<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cockney Cards | Personalised Cards, Made For You</title>
<meta name="description" content="Cockney Cards — personalised cards for every occasion. Add your own text, photos and make it truly yours.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Dancing+Script:wght@600;700&family=Helvetica+Neue&display=swap" rel="stylesheet">

<style>
    :root {
        --navy: #0c1c3a;
        --navy-light: #142a52;
        --gold: #c8a04d;
        --gold-light: #e2c072;
        --cream: #f4efe4;
        --dark: #1e1e24;
        --muted: #666;
        --border-color: #e0e0e0;
        --font-heading: 'Playfair Display', Georgia, serif;
        --font-script: 'Dancing Script', cursive;
        --font-body: 'Helvetica Neue', Arial, sans-serif;
    }

    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body {
        font-family: var(--font-body);
        margin: 0;
        padding: 0;
        background-color: #fff;
        color: var(--dark);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    a { color: inherit; }

    .visually-hidden {
        position: absolute; width: 1px; height: 1px;
        overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap;
    }

    /* ANNOUNCEMENT BAR */
    .announce {
        background: var(--navy);
        color: var(--gold-light);
        text-align: center;
        font-size: 13px;
        letter-spacing: 0.06em;
        padding: 10px 20px;
        font-weight: 600;
    }
    .announce span { margin-left: 8px; }

    /* HEADER */
    header { background-color: white; padding: 14px 40px; border-bottom: 1px solid var(--border-color); }
    .header-inner {
        max-width: 1400px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 20px;
    }
    .logo-container { display: flex; align-items: center; }
    .logo-container img { max-width: 76px; height: auto; }

    nav.primary-nav { display: flex; justify-content: center; gap: 34px; }
    nav.primary-nav a {
        text-decoration: none;
        color: var(--navy);
        font-size: 14px;
        letter-spacing: 0.04em;
        font-weight: 600;
        padding-bottom: 4px;
        border-bottom: 2px solid transparent;
        display: flex;
        align-items: center;
        gap: 4px;
        white-space: nowrap;
    }
    nav.primary-nav a.active { border-bottom-color: var(--gold); color: var(--navy); }
    nav.primary-nav a:hover { color: var(--gold); }
    nav.primary-nav svg { width: 10px; height: 10px; }

    .header-icons { display: flex; justify-content: flex-end; align-items: center; gap: 22px; }
    .header-icons a { display: flex; color: var(--navy); }
    .header-icons svg { width: 20px; height: 20px; }
    .cart-wrap { position: relative; }
    .cart-count {
        position: absolute; top: -8px; right: -9px;
        background: var(--navy); color: white;
        font-size: 10px; font-weight: 700;
        width: 16px; height: 16px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
    }

    /* HERO */
    .hero {
        background: var(--cream);
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
    }
    .hero-copy { padding: 70px 60px; max-width: 560px; margin: 0 auto; width: 100%; }
    .hero-copy h1 {
        font-family: var(--font-heading);
        font-size: 2.9rem;
        line-height: 1.15;
        color: var(--navy);
        margin: 0 0 18px;
        font-weight: 700;
    }
    .hero-rule {
        width: 90px; height: 2px; background: var(--gold);
        margin: 0 0 22px; position: relative;
    }
    .hero-rule::after {
        content: '';
        position: absolute; left: 50%; top: 50%;
        width: 7px; height: 7px; background: var(--gold);
        transform: translate(-50%, -50%) rotate(45deg);
    }
    .hero-copy p.lede {
        font-size: 1.02rem; line-height: 1.6; color: #4a4a4a;
        margin: 0 0 32px;
    }
    .hero-actions { display: flex; gap: 16px; flex-wrap: wrap; }
    .btn {
        font-family: var(--font-body);
        font-size: 13px;
        letter-spacing: 0.06em;
        font-weight: 700;
        padding: 15px 28px;
        text-decoration: none;
        display: inline-block;
        text-transform: uppercase;
    }
    .btn-solid { background: var(--navy); color: white; }
    .btn-solid:hover { background: var(--navy-light); }
    .btn-outline { background: transparent; color: var(--navy); border: 1.5px solid var(--navy); }
    .btn-outline:hover { background: var(--navy); color: white; }

    .hero-visual { display: flex; align-items: center; justify-content: center; padding: 50px; }

    /* Card mockup graphic (used in hero + occasion tiles) */
    .card-scene {
        position: relative;
        width: 260px;
        height: 300px;
    }
    .card-scene .envelope {
        position: absolute;
        width: 190px; height: 240px;
        background: var(--gold-light);
        opacity: 0.35;
        left: 8px; top: 30px;
        border-radius: 2px;
    }
    .card-scene .card {
        position: absolute;
        width: 190px; height: 250px;
        background: white;
        left: 45px; top: 10px;
        box-shadow: 0 18px 40px rgba(12,28,58,0.18);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 14px;
        border-radius: 1px;
    }
    .card-scene .card .script {
        font-family: var(--font-script);
        color: var(--navy);
        font-size: 1.7rem;
        line-height: 1.15;
        font-weight: 700;
    }
    .card-scene .card .heart { color: var(--gold); font-size: 1.1rem; margin-top: 8px; }
    .card-scene .accessory { position: absolute; font-size: 2.1rem; opacity: 0.9; }
    .card-scene .accessory.gift { left: -6px; bottom: 6px; }
    .card-scene .accessory.plant { left: -4px; bottom: 10px; }
    .card-scene .accessory.candle { right: 2px; bottom: 8px; }
    .card-scene .accessory.stars { color: var(--gold); font-size: 1rem; position: absolute; }

    /* SHOP BY OCCASION */
    .occasions {
        background: var(--navy);
        color: white;
        padding: 60px 40px 50px;
    }
    .section-heading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        max-width: 900px;
        margin: 0 auto 40px;
    }
    .section-heading .line { flex: 1; height: 1px; background: rgba(200,160,77,0.4); }
    .section-heading .dot { width: 6px; height: 6px; background: var(--gold); transform: rotate(45deg); }
    .section-heading h2 {
        font-family: var(--font-heading);
        font-size: 1.7rem;
        letter-spacing: 0.05em;
        margin: 0;
        white-space: nowrap;
        font-weight: 700;
    }

    .occasion-grid {
        max-width: 1300px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 22px;
    }
    .occasion-card {
        background: white;
        color: var(--dark);
        text-decoration: none;
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(255,255,255,0.08);
    }
    .occasion-card .thumb {
        background: var(--cream);
        display: flex;
        align-items: center;
        justify-content: center;
        height: 220px;
        overflow: hidden;
    }
    .occasion-card .thumb .card-scene { transform: scale(0.62); }
    .occasion-card .label {
        padding: 16px 18px 20px;
        text-align: center;
    }
    .occasion-card .label .name {
        font-weight: 700;
        font-size: 0.95rem;
        letter-spacing: 0.06em;
        color: var(--navy);
        text-transform: uppercase;
        margin: 0 0 6px;
    }
    .occasion-card .label .shop-now {
        font-size: 0.8rem;
        color: var(--gold);
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .view-all-wrap { text-align: center; margin-top: 32px; }
    .btn-ghost {
        display: inline-block;
        color: var(--gold-light);
        border: 1.5px solid var(--gold);
        font-size: 13px;
        letter-spacing: 0.08em;
        font-weight: 700;
        padding: 14px 34px;
        text-decoration: none;
        text-transform: uppercase;
    }
    .btn-ghost:hover { background: var(--gold); color: var(--navy); }

    /* FEATURES BAR */
    .features {
        background: var(--cream);
        padding: 34px 40px;
    }
    .features-grid {
        max-width: 1300px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
    }
    .feature { display: flex; align-items: center; gap: 14px; }
    .feature svg { width: 28px; height: 28px; flex-shrink: 0; color: var(--navy); }
    .feature .f-title { font-size: 13px; font-weight: 700; letter-spacing: 0.03em; color: var(--navy); margin: 0 0 3px; text-transform: uppercase; }
    .feature .f-desc { font-size: 12.5px; color: var(--muted); line-height: 1.4; margin: 0; }

    /* FOOTER */
    footer { border-top: 1px solid var(--border-color); padding: 44px 40px 20px; background-color: white; }
    .footer-grid { max-width: 1300px; margin: 0 auto; display: flex; justify-content: center; gap: 60px; flex-wrap: wrap; }
    .footer-col { font-size: 13px; line-height: 1.8; color: #333; text-align: left; }
    .footer-col h4 { font-family: var(--font-heading); font-size: 15px; font-weight: 700; margin: 0 0 20px; letter-spacing: 0.5px; color: var(--navy); }
    .footer-col p { margin: 0 0 15px 0; }
    .footer-col a { color: #111; text-decoration: underline; }
    .footer-bottom { max-width: 1300px; margin: 30px auto 0 auto; border-top: 1px solid #f0f0f0; padding-top: 20px; text-align: center; font-size: 11px; color: #888; letter-spacing: 0.5px; }

    /* RESPONSIVE */
    @media (max-width: 1024px) {
        .occasion-grid { grid-template-columns: repeat(3, 1fr); }
        .features-grid { grid-template-columns: repeat(2, 1fr); }
        .hero { grid-template-columns: 1fr; }
        .hero-visual { order: -1; padding: 40px 40px 0; }
        .hero-copy { padding: 40px; margin: 0; max-width: none; text-align: center; }
        .hero-rule { margin-left: auto; margin-right: auto; }
        .hero-actions { justify-content: center; }
    }
    @media (max-width: 720px) {
        header { padding: 14px 20px; }
        .header-inner { grid-template-columns: auto 1fr auto; }
        nav.primary-nav { display: none; }
        .occasion-grid { grid-template-columns: repeat(2, 1fr); }
        .features-grid { grid-template-columns: 1fr; }
        .section-heading h2 { font-size: 1.3rem; }
        .hero-copy h1 { font-size: 2.1rem; }
    }
</style>
</head>
