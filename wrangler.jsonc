{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "cockney-cards",
    "compatibility_date": "2026-08-15",
    "main": "_worker.js",
    "observability": {
        "enabled": true
    },
    "vars": {
        "ALLOWED_ORIGIN": "https://cockneycards.com",
        "FROM_EMAIL": "reminders@cockneycards.com",
        "SITE_URL": "https://cockneycards.com"
    },
    "assets": {
        "directory": ".",
        "binding": "ASSETS"
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "cockney-cards-db",
            "database_id": "8e2f554f-822b-47ac-9f93-768a5421cdb5"
        }
    ],
    "r2_buckets": [
        {
            "binding": "ORDER_PDFS",
            "bucket_name": "order-pdfs-r2"
        }
    ]
}
